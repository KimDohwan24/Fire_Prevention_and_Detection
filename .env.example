# ============================================
# 환경변수 템플릿 (이 파일은 깃에 커밋됩니다)
# 복사해서 .env 를 만든 뒤 실제 값을 채워주세요.
#   cp .env.example .env
# 실제 키는 절대 이 파일에 적지 마세요.
# ============================================
#
# ⚠️ 반드시 채워야 하는 값 4개 — 비워 두면 서버가 아예 뜨지 않습니다.
#
#     DB_PASSWORD            본인 PostgreSQL 비밀번호
#     JWT_SECRET             로그인 토큰 서명 키
#     INTERNAL_API_KEY       AI 모델 → 백엔드 인증 키 (X-Internal-Key)
#     AGENCY_CALLBACK_KEY    소방서 → 백엔드 출동 통지 인증 키 (X-Agency-Key)
#
#   뒤의 셋은 back/config.py 의 시크릿 가드가 기동할 때 검사합니다. 비어 있거나
#   예전 기본값(dev-secret-change-me 등)이면 어느 값이 문제인지 알려주고 멈춥니다.
#   2026-08-24 이전에는 이것들이 비면 소스코드에 적힌 기본값으로 조용히 돌았는데,
#   JWT_SECRET 은 로그인 토큰의 서명 키라 그 값을 아는 사람은 서버를 거치지 않고
#   user_role: ADMIN 짜리 토큰을 직접 만들어 넣을 수 있었습니다. 그래서 막았습니다.
#
#   세 시크릿 만들기 (셋 다 같은 방법, 서로 다른 값으로):
#     python -c "import secrets; print(secrets.token_urlsafe(32))"
#
#   나머지 값은 전부 선택입니다 — 비우면 기본값으로 돌거나 그 기능만 꺼집니다.
#   각 항목 주석에 "미설정 시 ..." 로 적어 두었습니다.
# ============================================

# ----- 실행 환경 -----
APP_PORT=5000

# ----- 외부 API 키 -----
# 국가교통정보센터(its.go.kr) CCTV 개방 데이터 인증키.
# CCTV 목록(이름·좌표·HLS 스트림 주소)을 받아 cctv 테이블에 넣는 데 쓴다.
# 발급: https://its.go.kr 회원가입 → 오픈API 활용 신청
# 이 값이 비어 있으면 스트림 주소 갱신을 건너뛰고 DB 에 저장된 주소를 그대로 쓴다.
CCTV_API_KEY=
# ITS 오픈 API 주소 (미설정 시 아래 기본값)
# ITS_API_URL=https://openapi.its.go.kr:9443/cctvInfo
# 조회할 도로 유형 — ex=고속도로, its=국도 (쉼표 구분, 미설정 시 ex,its)
# ITS_ROAD_TYPES=ex,its

# 생활안전지도(safemap.go.kr) 인증키.
# 전국 소방서·119안전센터 목록(IF_0038)을 받아 agency 테이블을 채우는 데 쓴다.
# 발급: https://www.safemap.go.kr 개발자센터 → 오픈API 인증키 발급 (승인까지 시간이 걸린다)
# 쓰는 곳은 back/services/agencies_safemap.py 하나뿐이라, 비어 있어도 서버는 정상 동작한다.
AGENCY=
# 같은 영역 조회 결과 재사용 시간(초) (미설정 시 300)
# CCTV_URL_TTL_SEC=300
# 스트림 주소 자동 갱신 스위치 — false/0 이면 끈다 (미설정 시 켜짐)
# ITS_REFRESH_ENABLED=true
# 소방서 목록 오픈API 주소 (미설정 시 아래 기본값)
# SAFEMAP_API_URL=https://www.safemap.go.kr/openapi2/IF_0038

# ----- 텔레그램 알림 (화재 알림 발송 + 버튼 응답 수신) -----
# 화재 알림을 사용자 휴대폰으로 보내고, 알림에 붙은 버튼으로 확인/취소를 되받는 채널.
#
# 왜 문자가 아니라 텔레그램인가:
#   우리 알림은 유예(ALERT_DEADLINE_SEC) 안에 응답을 되받아야 의미가 있다 —
#   무응답이면 119 자동 신고로 넘어가기 때문이다. 그런데 문자는 **회신을 받을 수 없다**
#   (수신 번호는 월정액 임대 영역이라 무료 경로가 없다). 발송조차 발신번호 사전등록이
#   법적 전제고, 카톡 알림톡은 사업자등록증이 있어야 시작조차 못 한다.
#   텔레그램 봇은 무료·무제한이고 인라인 버튼으로 회신을 받으며, 롱폴링이라
#   공인 IP·HTTPS 웹훅이 필요 없다 — 로컬 시연 구성 그대로 돈다.
#
# 설정 방법 (5분):
#   1) 텔레그램에서 @BotFather 를 찾아 /newbot → 봇 이름과 사용자명을 정한다
#   2) 받은 토큰을 TELEGRAM_BOT_TOKEN 에, 봇 사용자명(@ 없이)을 TELEGRAM_BOT_USERNAME 에
#   3) 서버를 띄우고 웹 마이페이지의 '텔레그램 연동' 링크를 누르면 끝
#
# ⚠️ 토큰은 봇을 통째로 조종할 수 있는 값이다. .env 는 커밋하지 말 것 (.gitignore 확인).
#
# **비워 두면 텔레그램 발송·폴링이 통째로 꺼지고 알림은 기존 모의 SMS 로만 나간다.**
# 토큰 없이도 서버는 그대로 뜨고 나머지 경로는 전부 살아 있다.
# TELEGRAM_BOT_TOKEN=
# TELEGRAM_BOT_USERNAME=
# Bot API HTTP 타임아웃(초) (미설정 시 5). 롱폴링에서는 서버 대기시간에 얹는 여유분이다.
# TELEGRAM_HTTP_TIMEOUT_SEC=5
# 롱폴링에서 텔레그램 서버가 응답을 붙잡고 기다려 주는 시간(초) (미설정 시 25).
# 폴링 '주기'가 아니다 — 업데이트가 생기면 서버가 기다림을 끊고 곧바로 돌려주므로
# 이 값을 줄여도 버튼 반응은 빨라지지 않고 빈 요청 수만 늘어난다.
# 3초 미만으로 두지 말 것: getUpdates 는 직전 요청과 3초 안에 붙으면 서버가 정확히
# 3초를 붙잡는다(2026-08-22 실측). 예전 2초 주기 폴링이 계속 밀렸던 원인이 이것이다.
# TELEGRAM_LONG_POLL_SEC=25

# ----- DB (PostgreSQL) -----
DB_HOST=localhost
DB_PORT=5432
DB_NAME=fireguard
DB_USER=
DB_PASSWORD=

# ----- 기타 -----
# ⚠️ 필수 — 비워 두면 서버가 뜨지 않는다 (back/config.py 의 시크릿 가드).
# 로그인 토큰 서명·OAuth state·계정찾기 코드·텔레그램 연동코드가 전부 이 값 하나에
# 걸려 있다. 기본값이나 빈 값이면 누구나 관리자 토큰을 위조할 수 있다.
# 값 만들기: python -c "import secrets; print(secrets.token_urlsafe(32))"
JWT_SECRET=
JWT_EXPIRES_HOURS=12

# ----- 회원가입 이메일 인증 (SMTP) -----
# 가입 화면이 인증번호 메일을 보낼 때 쓴다 (back/routes/auth_routes.py).
# 비워 두면 서버는 그대로 뜨고, 메일 발송만 실패한다 ("이메일 전송 실패" 로그).
# 지메일이면: SMTP_SERVER=smtp.gmail.com / SMTP_PORT=587 이고, SENDER_PASSWORD 는
# 계정 비밀번호가 아니라 **앱 비밀번호**다 (구글 계정 → 보안 → 2단계 인증 → 앱 비밀번호).
# ⚠️ 메일 계정 비밀번호이므로 .env 에만 두고 이 파일에 적지 말 것.
# SMTP_SERVER=smtp.gmail.com
# SMTP_PORT=587
# SENDER_EMAIL=
# SENDER_PASSWORD=

# ----- 소셜 로그인 (OAuth) -----
# 세 프로바이더 각각의 개발자 콘솔에서 앱을 만들고 키를 발급받아 넣는다.
#   구글  : https://console.cloud.google.com  → API 및 서비스 → 사용자 인증 정보
#           → OAuth 클라이언트 ID(웹 애플리케이션)
#   카카오: https://developers.kakao.com  → 내 애플리케이션 → 앱 키(REST API 키)
#           → 카카오 로그인 활성화 + 동의항목(닉네임·이메일) 설정
#           CLIENT_SECRET 은 [보안] 탭에서 켜야 값이 생긴다
#   네이버: https://developers.naver.com/apps  → 애플리케이션 등록
#           → 사용 API 에 '네이버 로그인' 추가
#
# ⚠️ 세 콘솔 모두에 **redirect URI 를 등록해야 한다.** 서버가 만들어 보내는 값과 글자
#    하나라도 다르면 프로바이더가 redirect_uri_mismatch 로 돌려보낸다.
#    등록할 값은 프로바이더당 **하나뿐이고**, 아래 OAUTH_CALLBACK_BASE(= 백엔드 자신의
#    주소)로 서버가 계산한다 — 프로바이더는 브라우저를 프론트가 아니라 백엔드로
#    되돌려보내기 때문이다 (프론트는 시작만 시킨다):
#      {OAUTH_CALLBACK_BASE}/api/auth/google/callback
#      {OAUTH_CALLBACK_BASE}/api/auth/kakao/callback
#      {OAUTH_CALLBACK_BASE}/api/auth/naver/callback
#
#    아래 OAUTH_REDIRECT_BASE(프론트 주소)는 **콘솔에 등록하는 값이 아니다.** 로그인을
#    끝낸 사용자를 보낼 곳일 뿐이라 역할이 전혀 다르다 — 두 변수를 바꿔 넣으면 증상이
#    redirect_uri_mismatch 로만 나타나 원인을 찾기 어렵다.
#
# 비워 두면 그 프로바이더만 503 OAUTH_NOT_CONFIGURED 로 막힌다 — 서버는 그대로 뜨고
# 일반 로그인과 나머지 프로바이더는 정상 동작한다. 하나도 안 넣어도 무방하다.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
KAKAO_CLIENT_ID=
KAKAO_CLIENT_SECRET=
NAVER_CLIENT_ID=
NAVER_CLIENT_SECRET=
# 프론트 주소 (미설정 시 http://localhost:5173 — Vite 개발 서버 기본 포트).
# 로그인을 마친 브라우저를 여기로 돌려보낸다 ({...}/#access_token=... 또는 /#oauth_error=...).
# 콘솔 등록값과는 무관하니 배포 시 실제 프론트 도메인으로만 바꾸면 된다.
# OAUTH_REDIRECT_BASE=http://localhost:5173
# 백엔드 자신의 주소 (미설정 시 http://localhost:5000 — APP_PORT 기본값과 같다).
# **콘솔에 등록하는 콜백 주소가 여기서 나온다.** 배포 시 실제 백엔드 도메인으로
# 바꾸고 세 콘솔의 등록 URI 도 함께 고칠 것.
# OAUTH_CALLBACK_BASE=http://localhost:5000
# 프로바이더 API 호출 타임아웃(초) (미설정 시 5)
# OAUTH_HTTP_TIMEOUT_SEC=5

# ----- 내부 검출 수집 API (AI 모델 → 백엔드) -----
# ⚠️ 아래 둘도 필수 — 비워 두면 서버가 뜨지 않는다.
#    예전에는 미설정 시 dev-internal-key / dev-agency-key 로 조용히 돌았는데,
#    소스코드에 적힌 값이라 아는 사람은 그대로 인증을 통과했다 (2026-08-24 차단).
#    값 만들기: python -c "import secrets; print(secrets.token_urlsafe(32))"
# X-Internal-Key 헤더 값. ai-model/run_video.py 가 이 파일에서 같은 값을 읽어 간다.
INTERNAL_API_KEY=
# 소방서(119)가 출동 통지를 되쏠 때 쓰는 인증 키 (X-Agency-Key 헤더).
# 시연에서는 mock-119 콘솔 화면에 이 값을 입력해 쓴다 — 브라우저에 노출되므로
# 운영 키를 넣지 말 것.
AGENCY_CALLBACK_KEY=
# 화재 확정 기준 프레임 수 / 관측 창 길이(초, 최초 감지 시각 기준 고정).
# 판정 기준의 정본은 back/config.py 다 — 여기 적으면 그 값이 우선하고, 기본값을
# 고쳐도 이 파일을 복사해 만든 .env 를 쓰는 사람만 옛 값으로 돌게 된다.
# 시연처럼 일시적으로 바꿀 때만 주석을 풀 것 (미설정 시 10 / 60)
# ⚠️ 임계값은 검출 프레임 레이트에 묶여 있다. 여기서 올리면 창 안에 프레임이
#    모이지 않아 확정이 아예 안 될 수 있다 — 근거는 back/config.py 주석 참고.
# EVENT_THRESHOLD_FRAMES=10
# EVENT_WINDOW_SEC=60

# ----- 알림 (사용자 알림 → 무응답 시 119) -----
# 알림 응답 유예 시간(초): 화재 확정 시 PUSH+SMS 를 동시에 보내고,
# 이 시간까지 무응답이면 119 자동 신고로 넘어간다 (단계 승격 없음)
# 위 EVENT_* 와 같은 이유로 주석 처리해 둔다 (미설정 시 60)
# ALERT_DEADLINE_SEC=60
# 에스컬레이션 스윕 주기(초) (미설정 시 5)
# 유예 마감 초과가 신고로 이어지기까지 최대 이만큼 늦어진다.
# 2026-08-10 에 10 → 5 로 낮췄다 (유예가 3분에서 30초로 짧아졌기 때문).
# 기존 .env 에 10 을 직접 적어 둔 사람은 그 값이 그대로 쓰이니 확인할 것.
# ESCALATION_INTERVAL_SEC=5

# ----- 역지오코딩 (좌표 → 주소) -----
# CCTV 등록 시 좌표를 주소로 바꿔 cctv_address 에 저장한다. 119 신고에 싣는 값이다.
# 별도 키가 필요 없다 — 아래 소셜 로그인용 KAKAO_CLIENT_ID(REST 키)를 그대로 쓴다.
# 다만 카카오 개발자 콘솔에서 그 앱의 '카카오맵' 서비스가 켜져 있어야 한다.
# 꺼져 있으면 403 NotAuthorizedError 가 오고, 주소 없이(좌표 문자열로) 신고된다.
# 요청 타임아웃(초). 사람이 등록 버튼을 누르고 기다리는 시간이라 짧게 둔다.
GEOCODE_HTTP_TIMEOUT_SEC=

# ----- 119 신고 -----
# 영상 테스트에서 CONFIRM_FIRE 를 눌렀을 때만 전송하는 모의 접수 주소.
# 실제 119 신고 기관 endpoint/report_119 장부와 분리한다.
# MOCK119_TEST_ENDPOINT=http://127.0.0.1:8119/report?mode=ok&station=test
# 한 기관에 최대 몇 번 전송을 시도하나 (미설정 시 1 = 한 왕복으로 끝, 재전송 없음)
# 4 로 두면 재시도할 값어치가 있는 실패(타임아웃·5xx)에 한해 4 회까지 재전송한다
# MAX_REPORT_ATTEMPTS=1
# 기관 endpoint HTTP 전송 타임아웃(초) (미설정 시 3)
# REPORT_HTTP_TIMEOUT_SEC=3
# 시도할 최대 기관 수 (미설정 시 1 = 가장 가까운 한 곳, 승계 없음)
# 0 으로 두면 후보 전체를 가까운 순서대로 시도한다 (기관 승계 동작)
# REPORT_MAX_AGENCIES=1
# 이 백엔드의 외부 공개 주소. 119 신고에 실어 보내는 callback_url 이 여기서 만들어진다
#   {PUBLIC_BASE_URL}/api/reports/dispatch  ← 소방서가 출동 통지를 되쏘는 곳
# 같은 PC 에서 시연하면 기본값으로 충분하다. 다른 PC 에서 접속시키려면 LAN IP.
PUBLIC_BASE_URL=

# ----- 미디어 파일 -----
# 검출 프레임/클립이 저장되는 디렉터리. GET /media/<path> 로 서빙된다.
# 미설정 시 프로젝트 루트의 media/ (상대경로로 줘도 절대경로로 바뀐다)
# MEDIA_ROOT=

# ----- 로깅 -----
# 어느 수준부터 남길지 (미설정 시 INFO). 시끄러우면 WARNING, 파고들 때는 DEBUG.
# LOG_LEVEL=INFO
# 로그 파일이 쌓이는 곳 (미설정 시 back/logs/ — .gitignore 에 걸려 있다)
# LOG_DIR=
# 자정마다 fireguard.log.YYYY-MM-DD 로 넘기고 며칠분을 남길지 (미설정 시 14)
# LOG_BACKUP_DAYS=14

# ----- 이 파일이 다루지 않는 것 -----
# 아래 값들은 .env 를 읽지 않고 **프로세스 환경변수만** 본다. 여기 적어도 안 먹는다.
#   MOCK119_PORT / MOCK119_DEFAULT_MODE / MOCK119_SLEEP_SEC
#       가상 119 서버 설정. mock-119/app.py 는 dotenv 를 로드하지 않는다
#       (기본값과 쓰는 법은 그 파일 맨 위 docstring 에 있다)
#   FIREGUARD_API
#       ai-model 이 검출을 보낼 백엔드 주소. run_video.py 의 --api 기본값이며,
#       그 스크립트가 .env 에서 읽는 값은 INTERNAL_API_KEY 와 MEDIA_ROOT 둘뿐이다
