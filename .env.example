# ============================================
# 환경변수 템플릿 (이 파일은 깃에 커밋됩니다)
# 복사해서 .env 를 만든 뒤 실제 값을 채워주세요.
#   cp .env.example .env
# 실제 키는 절대 이 파일에 적지 마세요.
# ============================================

# ----- 실행 환경 -----
NODE_ENV=development
APP_PORT=5000

# ----- 외부 API 키 -----
# 예시) 기상청/날씨 API, 알림 발송, AI 모델 API 등
API_KEY=
WEATHER_API_KEY=
NOTIFY_API_KEY=

# ----- DB (PostgreSQL) -----
DB_HOST=localhost
DB_PORT=5432
DB_NAME=fireguard
DB_USER=
DB_PASSWORD=

# ----- 기타 -----
JWT_SECRET=
JWT_EXPIRES_HOURS=12

# ----- 내부 검출 수집 API (AI 모델 → 백엔드) -----
# X-Internal-Key 헤더 값 (미설정 시 개발용 기본값 dev-internal-key)
INTERNAL_API_KEY=
# 화재 확정 기준 프레임 수 / 검출 끊김 판정 윈도우(초)
EVENT_THRESHOLD_FRAMES=30
EVENT_WINDOW_SEC=60

# ----- 알림 (사용자 알림 → 무응답 시 119) -----
# 알림 응답 유예 시간(분): 화재 확정 시 PUSH+SMS 를 동시에 보내고,
# 이 시간까지 무응답이면 119 자동 신고로 넘어간다 (단계 승격 없음)
ALERT_DEADLINE_MIN=3
# 에스컬레이션 스윕 주기(초) (미설정 시 10)
# ESCALATION_INTERVAL_SEC=10

# ----- 119 신고 -----
# 한 기관에 최대 몇 번 전송을 시도하나 (미설정 시 4)
# MAX_REPORT_ATTEMPTS=4
# 기관 endpoint HTTP 전송 타임아웃(초) (미설정 시 3)
# REPORT_HTTP_TIMEOUT_SEC=3

# ----- 미디어 파일 -----
# 검출 프레임/클립이 저장되는 디렉터리. GET /media/<path> 로 서빙된다.
# 미설정 시 프로젝트 루트의 media/ (상대경로로 줘도 절대경로로 바뀐다)
# MEDIA_ROOT=
