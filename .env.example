# ============================================
# 환경변수 템플릿 (이 파일은 깃에 커밋됩니다)
# 복사해서 .env 를 만든 뒤 실제 값을 채워주세요.
#   cp .env.example .env
# 실제 키는 절대 이 파일에 적지 마세요.
# ============================================

# ----- 실행 환경 -----
NODE_ENV=development
APP_PORT=5000

# ----- 외부 API 키 -----
# 국가교통정보센터(its.go.kr) CCTV 개방 데이터 인증키.
# CCTV 목록(이름·좌표·HLS 스트림 주소)을 받아 cctv 테이블에 넣는 데 쓴다.
# 발급: https://its.go.kr 회원가입 → 오픈API 활용 신청
# 이 값이 비어 있으면 스트림 주소 갱신을 건너뛰고 DB 에 저장된 주소를 그대로 쓴다.
CCTV_API_KEY=
# ITS 오픈 API 주소 (미설정 시 아래 기본값)
# ITS_API_URL=https://openapi.its.go.kr:9443/cctvInfo
# 조회할 도로 유형 — ex=고속도로, its=국도 (쉼표 구분, 미설정 시 ex,its)
# ITS_ROAD_TYPES=ex,its
# 같은 영역 조회 결과 재사용 시간(초) (미설정 시 300)
# CCTV_URL_TTL_SEC=300
# 스트림 주소 자동 갱신 스위치 — false/0 이면 끈다 (미설정 시 켜짐)
# ITS_REFRESH_ENABLED=true
# 문자(SMS) 발송 API 키 — 현재는 목(mock) 발송이라 미사용
NOTIFY_API_KEY=

# ----- DB (PostgreSQL) -----
DB_HOST=localhost
DB_PORT=5432
DB_NAME=fireguard
DB_USER=
DB_PASSWORD=

# ----- 기타 -----
JWT_SECRET=
JWT_EXPIRES_HOURS=12

# ----- 내부 검출 수집 API (AI 모델 → 백엔드) -----
# X-Internal-Key 헤더 값 (미설정 시 개발용 기본값 dev-internal-key)
INTERNAL_API_KEY=
# 화재 확정 기준 프레임 수 / 관측 창 길이(초, 최초 감지 시각 기준 고정)
EVENT_THRESHOLD_FRAMES=30
EVENT_WINDOW_SEC=60

# ----- 알림 (사용자 알림 → 무응답 시 119) -----
# 알림 응답 유예 시간(초): 화재 확정 시 PUSH+SMS 를 동시에 보내고,
# 이 시간까지 무응답이면 119 자동 신고로 넘어간다 (단계 승격 없음)
ALERT_DEADLINE_SEC=30
# 에스컬레이션 스윕 주기(초) (미설정 시 5)
# 유예 마감 초과가 신고로 이어지기까지 최대 이만큼 늦어진다.
# 2026-08-10 에 10 → 5 로 낮췄다 (유예가 3분에서 30초로 짧아졌기 때문).
# 기존 .env 에 10 을 직접 적어 둔 사람은 그 값이 그대로 쓰이니 확인할 것.
# ESCALATION_INTERVAL_SEC=5

# ----- 119 신고 -----
# 한 기관에 최대 몇 번 전송을 시도하나 (미설정 시 4)
# MAX_REPORT_ATTEMPTS=4
# 기관 endpoint HTTP 전송 타임아웃(초) (미설정 시 3)
# REPORT_HTTP_TIMEOUT_SEC=3

# ----- 미디어 파일 -----
# 검출 프레임/클립이 저장되는 디렉터리. GET /media/<path> 로 서빙된다.
# 미설정 시 프로젝트 루트의 media/ (상대경로로 줘도 절대경로로 바뀐다)
# MEDIA_ROOT=
