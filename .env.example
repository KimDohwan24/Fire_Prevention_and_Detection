# ============================================
# 환경변수 템플릿 (이 파일은 깃에 커밋됩니다)
# 복사해서 .env 를 만든 뒤 실제 값을 채워주세요.
#   cp .env.example .env
# 실제 키는 절대 이 파일에 적지 마세요.
# ============================================

# ----- 실행 환경 -----
NODE_ENV=development
APP_PORT=5000

# ----- 외부 API 키 -----
# 예시) 기상청/날씨 API, 알림 발송, AI 모델 API 등
API_KEY=
WEATHER_API_KEY=
NOTIFY_API_KEY=

# ----- DB (PostgreSQL) -----
DB_HOST=localhost
DB_PORT=5432
DB_NAME=fireguard
DB_USER=
DB_PASSWORD=

# ----- 기타 -----
JWT_SECRET=
JWT_EXPIRES_HOURS=12
